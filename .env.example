# ═══════════════════════════════════════════════════════════════════════════
# AI Job Intelligence Platform — the ONE .env file 
#
#   cp apps/web/.env.example apps/web/.env     then fill in the blanks.
#
# Never commit the real .env. Never prefix a secret with NEXT_PUBLIC_ — that
# ships it to the browser. See docs/api/ENVIRONMENT_VARIABLES.md and ADR-012.
# Phase 9 (extracting mcp-server / agent-worker) adds two shared tokens back.
# ═══════════════════════════════════════════════════════════════════════════

# ─── App ───────────────────────────────────────────────────────────────────
# Used for links inside emails/reports. Use the deployed URL in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Auth: Clerk ───────────────────────────────────────────────────────────
# Clerk dashboard → API keys (publishable key is safe for the browser).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Clerk dashboard → Webhooks → your endpoint → signing secret (starts with whsec_).
# Needed to verify user.created / user.deleted webhooks at /api/webhooks/clerk.
CLERK_WEBHOOK_SECRET=

# ─── Database: Neon Postgres + pgvector ────────────────────────────────────
# Neon dashboard → Connection details.
# DATABASE_URL = the POOLED string (host contains "-pooler"), used at runtime.
# DIRECT_URL   = the UNPOOLED string, used only by `prisma migrate`.
DATABASE_URL=
DIRECT_URL=

# ─── AI providers ──────────────────────────────────────────────────────────
# Gemini: resume parsing, match explanations, report text, and embeddings.
# Embedding size must equal vector(N) in packages/db/prisma/schema.prisma (1536).
# Multi-key pooling supported: auto-failover and load-distribution across keys.
GEMINI_API_KEY=
GEMINI_API_KEY2=
# Groq: fast/cheap inference for lighter steps (classification, short rewrites).
GROQ_API_KEY=
GROQ_API_KEY2=

# ─── Job discovery: scraping ───────────────────────────────────────────────
# Multi-engine crawling pipeline: Firecrawl 1 -> Firecrawl 2 -> Scrape.do -> direct fetch.
FIRECRAWL_API_KEY=
FIRECRAWL_API_KEY2=
SCRAPEDO_API_KEY=

# ─── Job discovery: free job APIs ──────────────────────────────────────────
# Direct ATS boards (Greenhouse, Lever, Ashby) need NO key — they are public
# JSON endpoints keyed by each company's slug, stored in the Company table.
#
# Each block below is optional: leave blank to disable that source.

# Adzuna — free, self-serve. Register an app to get both values.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in

# Jooble — free, but the key is EMAILED after you submit their request form
JOOBLE_API_KEY=

# JSearch (via RapidAPI) — free plan is ~200 requests/month
RAPIDAPI_KEY=

# The Muse
THE_MUSE_API_KEY=

# Findwork
FINDWORK_API_TOKEN=

# ─── Email: Brevo SMTP (via Nodemailer) ────────────────────────────────────
# Brevo dashboard → SMTP & API → SMTP tab.
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ─── Scheduling + pipeline: Inngest ────────────────────────────────────────
# Local dev: run `npx inngest-cli dev` — no keys needed.
# Production: Inngest dashboard → Manage → Event keys / Signing key.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ─── Resume temp storage: NeonDB Object Storage (AWS S3-compatible) ─────────
# Server-side only, via @aws-sdk/client-s3 + @aws-sdk/s3-request-presigner (see ADR-013).
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
STORAGE_BUCKET_NAME=
