{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "DIRECT_URL",
    "NEXT_PUBLIC_APP_URL",
    "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY",
    "CLERK_SECRET_KEY",
    "CLERK_WEBHOOK_SECRET",
    "NEXT_PUBLIC_CLERK_SIGN_IN_URL",
    "NEXT_PUBLIC_CLERK_SIGN_UP_URL",
    "GEMINI_API_KEY",
    "GEMINI_API_KEY2",
    "GROQ_API_KEY",
    "GROQ_API_KEY2",
    "FIRECRAWL_API_KEY",
    "FIRECRAWL_API_KEY2",
    "SCRAPEDO_API_KEY",
    "ADZUNA_APP_ID",
    "ADZUNA_APP_KEY",
    "ADZUNA_COUNTRY",
    "JOOBLE_API_KEY",
    "RAPIDAPI_KEY",
    "THE_MUSE_API_KEY",
    "FINDWORK_API_TOKEN",
    "SMTP_HOST",
    "SMTP_PORT",
    "SMTP_USER",
    "SMTP_PASS",
    "SMTP_FROM",
    "INNGEST_EVENT_KEY",
    "INNGEST_SIGNING_KEY",
    "AWS_ENDPOINT_URL_S3",
    "AWS_ACCESS_KEY_ID",
    "AWS_SECRET_ACCESS_KEY",
    "AWS_REGION",
    "STORAGE_BUCKET_NAME"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@repo/db#build": {
      "cache": false
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    }
  }
}
