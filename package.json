{
  "name": "ai-job-intelligence-platform",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @repo/db prisma generate",
    "db:migrate": "pnpm --filter @repo/db prisma migrate dev",
    "db:deploy": "pnpm --filter @repo/db deploy",
    "db:seed": "pnpm --filter @repo/db seed",
    "db:sync": "pnpm --filter @repo/db sync-jobs"
  },
  "devDependencies": {
    "turbo": "^2.1.0",
    "typescript": "^5.6.0"
  }
}
